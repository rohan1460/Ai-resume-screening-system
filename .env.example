# Copy to .env and adjust. Values here are the local-dev defaults used by docker-compose.

# --- Application ---
APP_NAME="AI Resume Screening System"
APP_ENV=local                 # local | staging | production
DEBUG=true
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true renders structlog output as JSON
API_HOST=0.0.0.0
API_PORT=8000
# Vite dev server; the containerised frontend is same-origin via nginx.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Auth ---
# Static bearer token protecting the /jobs endpoints; /health stays public.
# Leave unset for local development. REQUIRED when APP_ENV is staging or production —
# the app refuses to start without it. Minimum 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# --- Postgres ---
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_screening
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
# Both default to REDIS_* above; set to split broker from result backend.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
# Transient failures (DB restart, storage blip) are retried with exponential
# backoff: CELERY_RETRY_BACKOFF * 2^attempt seconds. Bad resumes are never retried.
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF=5
# How long task results linger in the Redis result backend (seconds).
CELERY_RESULT_EXPIRES=86400
# A worker child runs one task at a time, so it needs very few DB connections.
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=2
# Cap on the error text stored on a failed job.
MAX_ERROR_LENGTH=2000
WORKER_CONCURRENCY=2
# Host port for the containerised frontend.
FRONTEND_PORT=3000

# --- Object storage ---
# S3_ENDPOINT points at MinIO locally. Leave it EMPTY to use real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=resumes
S3_REGION=us-east-1

# Consumed by the MinIO container itself (the image requires these exact names).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- ML / NLP ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SPACY_MODEL=en_core_web_sm
# Keep this on cpu for Celery's prefork pool: a torch model on mps/cuda crashes
# forked children. Only change it for --pool=solo or --pool=threads.
EMBEDDING_DEVICE=cpu
# Load the embedding model at API startup so the first /rerank is not slow.
WARM_MODELS_ON_STARTUP=true

# --- Scoring ---
# final_score = W_SKILL * skill_score + W_SEMANTIC * semantic_score
# These must sum to 1.0.
W_SKILL=0.6
W_SEMANTIC=0.4
SKILLS_DICTIONARY_PATH=config/skills.txt
# Optional overlay file: adds skills/aliases on top of the curated list.
# EXTRA_SKILLS_PATH=config/skills.local.txt

# --- Uploads ---
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx
